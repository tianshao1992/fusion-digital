{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusiondigital.example/schemas/device-manifest-1.5.json",
  "title": "FusionDigital browser-safe device package manifest",
  "description": "Public metadata contract for a derived 3D asset. Authoritative CAD/CAE files remain in the controlled engineering data zone.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "asOf", "devicePackage", "access", "coordinateSystem", "assets", "systems", "generator", "disclaimer"],
  "properties": {
    "schemaVersion": { "enum": ["1.1", "1.2", "1.3", "1.4", "1.5"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "devicePackage": {
      "type": "object",
      "required": ["kind", "deviceClass", "authority", "replacementContract"],
      "properties": {
        "kind": { "enum": ["public-demonstrator", "public-simplified-derivative", "controlled-engineering"] },
        "deviceClass": { "type": "string" },
        "authority": { "enum": ["illustrative", "engineering-reference", "authoritative"] },
        "replacementContract": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["classification", "redistributionAllowed", "engineeringUseAllowed", "statement"],
      "properties": {
        "classification": { "enum": ["PUBLIC", "INTERNAL", "CONTROLLED", "RESTRICTED"] },
        "redistributionAllowed": { "type": "boolean" },
        "engineeringUseAllowed": { "type": "boolean" },
        "statement": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coordinateSystem": {
      "type": "object",
      "required": ["linearUnit", "upAxis", "handedness", "sourceToWebScale"],
      "properties": {
        "linearUnit": { "type": "string" },
        "upAxis": { "enum": ["X", "Y", "Z"] },
        "handedness": { "enum": ["right", "left"] },
        "sourceToWebScale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "anyOf": [
        { "required": ["webModel"] },
        { "required": ["componentBundles"] },
        { "required": ["shardBundles"] }
      ],
      "properties": {
        "webModel": { "$ref": "#/$defs/asset" },
        "webModels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/webModelVariant" },
          "allOf": [
            {
              "contains": { "type": "object", "required": ["quality"], "properties": { "quality": { "const": "preview" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "required": ["default"], "properties": { "default": { "const": true } } },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "componentBundles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentBundle" }
        },
        "shardBundles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/anonymousShardBundle" }
        },
        "sourceCad": { "$ref": "#/$defs/asset" },
        "poster": { "$ref": "#/$defs/assetWithoutFormat" }
      },
      "additionalProperties": false
    },
    "visualizations": {
      "type": "object",
      "properties": {
        "analyticPlasma": { "$ref": "#/$defs/analyticPlasma" }
      },
      "additionalProperties": false
    },
    "derivationEvidence": { "$ref": "#/$defs/anonymousDerivationEvidence" },
    "reviewCandidate": {
      "type": "object",
      "required": ["status", "productionEligible"],
      "properties": {
        "status": { "const": "USER_VISUAL_REVIEW_REQUIRED" },
        "productionEligible": { "const": false }
      },
      "additionalProperties": false
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "shortTitle", "category", "color", "description", "parts"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "shortTitle": { "type": "string" },
          "category": { "enum": ["plasma", "tf", "pf", "layer", "structure"] },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "description": { "type": "string" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "nodeName", "description", "engineeringTag"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "nodeName": { "type": "string" },
                "description": { "type": "string" },
                "engineeringTag": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "generator": { "type": "object" },
    "disclaimer": { "type": "string", "minLength": 30 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assets": { "required": ["componentBundles"] }
        },
        "required": ["assets"]
      },
      "then": { "properties": { "schemaVersion": { "enum": ["1.2", "1.3"] } } }
    },
    {
      "if": { "required": ["visualizations"] },
      "then": { "properties": { "schemaVersion": { "enum": ["1.2", "1.3", "1.4", "1.5"] } } }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.1", "1.2"] } },
        "required": ["schemaVersion"]
      },
      "then": { "properties": { "assets": { "required": ["webModel"] } } }
    },
    {
      "if": {
        "properties": {
          "assets": { "required": ["shardBundles"] }
        },
        "required": ["assets"]
      },
      "then": {
        "required": ["derivationEvidence"],
        "properties": {
          "schemaVersion": { "enum": ["1.4", "1.5"] },
          "id": { "const": "exl50u-general-assembly-v1" },
          "access": {
            "properties": {
              "classification": { "const": "PUBLIC" },
              "redistributionAllowed": { "const": true },
              "engineeringUseAllowed": { "const": false }
            }
          },
          "assets": {
            "properties": {
              "componentBundles": false,
              "sourceCad": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.4" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "id": { "const": "exl50u-general-assembly-v1" },
          "assets": {
            "required": ["webModel", "shardBundles"],
            "properties": {
              "webModel": {
                "allOf": [
                  { "$ref": "#/$defs/asset" },
                  {
                    "required": ["triangles", "vertices", "decodedGpuBytes", "boundsMetres"],
                    "properties": {
                      "path": { "pattern": "^/device-assets/exl50u-general-assembly/v1/device\\.preview\\.[a-f0-9]{64}\\.meshopt\\.glb$" },
                      "bytes": { "maximum": 12582912 },
                      "triangles": { "maximum": 30000000 },
                      "decodedGpuBytes": { "maximum": 201326592 }
                    }
                  }
                ]
              },
              "webModels": {
                "maxItems": 1,
                "items": {
                  "properties": { "quality": { "const": "preview" } }
                }
              }
            }
          },
          "derivationEvidence": { "$ref": "#/$defs/anonymousDerivationEvidence" }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.5" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "id": { "const": "exl50u-general-assembly-v1" },
          "assets": {
            "required": ["shardBundles"],
            "maxProperties": 1,
            "properties": {
              "webModel": false,
              "webModels": false,
              "componentBundles": false,
              "sourceCad": false,
              "poster": false,
              "shardBundles": {
                "items": {
                  "properties": { "bytes": { "const": 270978652 } }
                }
              }
            }
          },
          "derivationEvidence": { "$ref": "#/$defs/anonymousDerivationEvidence" }
        }
      }
    }
  ],
  "$defs": {
    "anonymousDerivationEvidence": {
      "type": "object",
      "required": [
        "kind", "selectedAttempt", "sourceInputCleaning", "previewVisualLod", "highQem", "highPartition", "coverage"
      ],
      "properties": {
        "kind": { "const": "anonymous-public-derivative" },
        "selectedAttempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sourceInputCleaning": {
          "type": "object",
          "required": [
            "policy", "definitionInputs", "sourceFaces", "sourceTriangles", "sanitizedTriangles", "removedTriangles",
            "affectedDefinitions", "removedUnreferencedVertices", "allDefinitionsAccounted", "allSourceFacesAccounted"
          ],
          "properties": {
            "policy": { "const": "repeated-index-and-exact-zero-area-drop-stable-vertex-remap-v1" },
            "definitionInputs": { "type": "integer", "minimum": 1 },
            "sourceFaces": {
              "type": "integer",
              "minimum": 1,
              "description": "Input face count only; it does not claim that source face or component boundaries survive either visual LOD."
            },
            "sourceTriangles": { "type": "integer", "minimum": 1 },
            "sanitizedTriangles": { "type": "integer", "minimum": 1 },
            "removedTriangles": { "type": "integer", "minimum": 0 },
            "affectedDefinitions": { "type": "integer", "minimum": 0 },
            "removedUnreferencedVertices": { "type": "integer", "minimum": 0 },
            "allDefinitionsAccounted": { "const": true },
            "allSourceFacesAccounted": { "const": true }
          },
          "additionalProperties": false
        },
        "previewVisualLod": {
          "type": "object",
          "required": [
            "algorithm", "selectedTargetTriangleRatio", "simplifierNormalizedErrorLimit",
            "maxAcceptedSimplifierReportedNormalizedError", "minimumTrianglesPerDefinition",
            "definitionsUsingMinimum", "minimumCoverage", "extremaCoverage",
            "retainedSourcePositionValuesUnchanged", "allDefinitionsNonempty", "boundsMissCount",
            "receiptCount", "receiptSha256", "outputCleaning", "visualQa"
          ],
          "properties": {
            "algorithm": { "const": "meshoptimizer-simplify-sloppy" },
            "selectedTargetTriangleRatio": { "const": 0.03 },
            "simplifierNormalizedErrorLimit": { "const": 0.02 },
            "maxAcceptedSimplifierReportedNormalizedError": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimumTrianglesPerDefinition": { "const": 12 },
            "definitionsUsingMinimum": { "type": "integer", "minimum": 0 },
            "minimumCoverage": { "const": "stable-source-order-minimum-plus-six-axis-extrema-v1" },
            "extremaCoverage": { "const": "six-axis-first-valid-nondegenerate-incident-triangle-v1" },
            "retainedSourcePositionValuesUnchanged": { "const": true },
            "allDefinitionsNonempty": { "const": true },
            "boundsMissCount": { "const": 0 },
            "receiptCount": { "type": "integer", "minimum": 1 },
            "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "outputCleaning": { "$ref": "#/$defs/anonymousOutputCleaning" },
            "visualQa": {
              "type": "object",
              "required": [
                "policy", "viewCount", "silhouetteIouFloor", "minimumObservedSilhouetteIou",
                "normalizedDepthP99Ceiling", "maximumObservedNormalizedDepthP99", "receiptSha256"
              ],
              "properties": {
                "policy": { "const": "canonical-10-view-silhouette-depth-1024-v1" },
                "viewCount": { "const": 10 },
                "silhouetteIouFloor": { "const": 0.97 },
                "minimumObservedSilhouetteIou": { "type": "number", "minimum": 0, "maximum": 1 },
                "normalizedDepthP99Ceiling": { "const": 0.02 },
                "maximumObservedNormalizedDepthP99": { "type": "number", "minimum": 0 },
                "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "status": { "const": "USER_VISUAL_REVIEW_REQUIRED" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "highQem": {
          "type": "object",
          "required": [
            "algorithm", "selectedTargetTriangleRatio", "simplifierNormalizedErrorLimit",
            "maxAcceptedSimplifierReportedNormalizedError", "minimumTrianglesPerDefinition",
            "definitionsUsingMinimum", "minimumCoverage", "extremaCoverage",
            "retainedSourcePositionValuesUnchanged", "allDefinitionsNonempty", "boundsMissCount",
            "receiptCount", "receiptSha256", "targetMissCount", "retainedIrreducibleCount", "outputCleaning"
          ],
          "properties": {
            "algorithm": { "const": "meshoptimizer-simplify-qem" },
            "selectedTargetTriangleRatio": { "enum": [0.7, 0.65] },
            "simplifierNormalizedErrorLimit": { "const": 0.0005 },
            "maxAcceptedSimplifierReportedNormalizedError": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimumTrianglesPerDefinition": { "const": 12 },
            "definitionsUsingMinimum": { "type": "integer", "minimum": 0 },
            "minimumCoverage": { "const": "stable-source-order-minimum-plus-six-axis-extrema-v1" },
            "extremaCoverage": { "const": "six-axis-first-valid-nondegenerate-incident-triangle-v1" },
            "retainedSourcePositionValuesUnchanged": { "const": true },
            "allDefinitionsNonempty": { "const": true },
            "boundsMissCount": { "const": 0 },
            "receiptCount": { "type": "integer", "minimum": 1 },
            "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "targetMissCount": { "type": "integer", "minimum": 0 },
            "retainedIrreducibleCount": { "type": "integer", "minimum": 0 },
            "outputCleaning": { "$ref": "#/$defs/anonymousOutputCleaning" }
          },
          "additionalProperties": false
        },
        "highPartition": {
          "type": "object",
          "required": [
            "policy", "geometryChunkCount", "splitDefinitionCount", "finalTrianglesBeforePartition",
            "partitionedTriangles", "missingTriangles", "duplicateTriangles", "missingOccurrences", "receiptSha256"
          ],
          "properties": {
            "policy": { "const": "stable-definition-triangle-chunks-v1" },
            "geometryChunkCount": { "type": "integer", "minimum": 1 },
            "splitDefinitionCount": { "type": "integer", "minimum": 0 },
            "finalTrianglesBeforePartition": { "type": "integer", "minimum": 1 },
            "partitionedTriangles": { "type": "integer", "minimum": 1 },
            "missingTriangles": { "const": 0 },
            "duplicateTriangles": { "const": 0 },
            "missingOccurrences": { "const": 0 },
            "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "required": [
            "renderableDefinitions", "renderableOccurrences", "skippedDefinitions", "skippedOccurrences",
            "sourceDefinitions", "sourceOccurrences", "previewMissingDefinitions",
            "previewMissingOccurrences", "highMissingDefinitions", "highMissingOccurrences"
          ],
          "properties": {
            "renderableDefinitions": { "type": "integer", "minimum": 1 },
            "renderableOccurrences": { "type": "integer", "minimum": 1 },
            "skippedDefinitions": { "type": "integer", "minimum": 0 },
            "skippedOccurrences": { "type": "integer", "minimum": 0 },
            "sourceDefinitions": { "type": "integer", "minimum": 1 },
            "sourceOccurrences": { "type": "integer", "minimum": 1 },
            "previewMissingDefinitions": { "const": 0 },
            "previewMissingOccurrences": { "const": 0 },
            "highMissingDefinitions": { "const": 0 },
            "highMissingOccurrences": { "const": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "anonymousOutputCleaning": {
      "type": "object",
      "required": [
        "policy", "selectedTrianglesBeforeCleaning", "finalTriangles", "removedRepeatedIndexTriangles",
        "removedZeroAreaTriangles", "removedDuplicateTriangles", "removedNonmanifoldTriangles",
        "repairedDefinitions", "finalRepeatedIndexTriangles", "finalZeroAreaTriangles",
        "finalDuplicateTriangles", "finalNonmanifoldEdgeCount"
      ],
      "properties": {
        "policy": { "const": "stable-repeated-zero-duplicate-edge-incidence-clean-v1" },
        "selectedTrianglesBeforeCleaning": { "type": "integer", "minimum": 1 },
        "finalTriangles": { "type": "integer", "minimum": 1 },
        "removedRepeatedIndexTriangles": { "type": "integer", "minimum": 0 },
        "removedZeroAreaTriangles": { "type": "integer", "minimum": 0 },
        "removedDuplicateTriangles": { "type": "integer", "minimum": 0 },
        "removedNonmanifoldTriangles": { "type": "integer", "minimum": 0 },
        "repairedDefinitions": { "type": "integer", "minimum": 0 },
        "finalRepeatedIndexTriangles": { "const": 0 },
        "finalZeroAreaTriangles": { "const": 0 },
        "finalDuplicateTriangles": { "const": 0 },
        "finalNonmanifoldEdgeCount": { "const": 0 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["path", "format", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "format": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" }
      },
      "additionalProperties": false
    },
    "assetWithoutFormat": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "webModelVariant": {
      "type": "object",
      "required": ["id", "label", "quality", "path", "format", "sha256", "bytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["preview", "high"] },
        "path": { "type": "string", "pattern": "^/" },
        "format": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" },
        "default": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "componentModel": {
      "type": "object",
      "required": ["partId", "nodeName", "path", "format", "sha256", "bytes", "triangles", "vertices", "sceneDrawTriangles", "sceneDrawVertices", "meshInstances", "decodedGpuBytes", "boundsMetres"],
      "properties": {
        "partId": { "type": "string", "minLength": 1 },
        "nodeName": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/device-assets/iter-high-detail/v1/[a-z0-9-]+\\.[a-f0-9]{64}\\.high\\.meshopt\\.glb$" },
        "format": { "const": "glTF 2.0 binary + EXT_meshopt_compression + KHR_mesh_quantization; POSITION normalized Int16 per mesh; NORMAL normalized Int8 (8-bit)" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "exclusiveMaximum": 25165824 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1 },
        "sceneDrawVertices": { "type": "integer", "minimum": 1 },
        "meshInstances": { "type": "integer", "minimum": 1, "maximum": 300 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" }
      },
      "additionalProperties": false
    },
    "componentBundle": {
      "type": "object",
      "required": ["id", "label", "quality", "delivery", "format", "bytes", "triangles", "vertices", "sceneDrawTriangles", "sceneDrawVertices", "meshInstances", "decodedGpuBytes", "boundsMetres", "components"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "quality": { "const": "high" },
        "delivery": { "const": "components" },
        "format": { "const": "glTF 2.0 binary + EXT_meshopt_compression + KHR_mesh_quantization; POSITION normalized Int16 per mesh; NORMAL normalized Int8 (8-bit)" },
        "bytes": { "type": "integer", "minimum": 80000000, "maximum": 110000000 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1 },
        "sceneDrawVertices": { "type": "integer", "minimum": 1 },
        "meshInstances": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentModel" }
        }
      },
      "additionalProperties": false
    },
    "anonymousShardModel": {
      "type": "object",
      "required": [
        "id", "index", "path", "sha256", "bytes", "uniqueGeometryMeshes",
        "uniqueGeometryTriangles", "uniqueGeometryVertices", "placementInstances",
        "drawCalls", "sceneDrawTriangles", "decodedGpuBytes", "boundsMetres"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^anonymous-shard-[0-9]{2}$" },
        "index": { "type": "integer", "minimum": 1, "maximum": 20 },
        "path": { "type": "string", "pattern": "^/device-assets/exl50u-general-assembly/v1/anonymous-shard-[0-9]{2}\\.[a-f0-9]{64}\\.high\\.meshopt\\.glb$" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "exclusiveMaximum": 25165824 },
        "uniqueGeometryMeshes": { "type": "integer", "minimum": 1 },
        "uniqueGeometryTriangles": { "type": "integer", "minimum": 1 },
        "uniqueGeometryVertices": { "type": "integer", "minimum": 1 },
        "placementInstances": { "type": "integer", "minimum": 1, "maximum": 250000 },
        "drawCalls": { "type": "integer", "minimum": 1, "maximum": 800 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1, "maximum": 35000000 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 100663296 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" }
      },
      "additionalProperties": false
    },
    "anonymousShardBundle": {
      "type": "object",
      "required": [
        "id", "label", "quality", "delivery", "format", "rootNodeName",
        "extensionsRequired", "grouping", "bytes", "uniqueGeometryMeshes",
        "uniqueGeometryTriangles", "uniqueGeometryVertices", "placementInstances",
        "drawCalls", "sceneDrawTriangles", "decodedGpuBytes", "boundsMetres", "shards"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "quality": { "const": "high" },
        "delivery": { "const": "shards" },
        "format": { "const": "glTF 2.0 binary + EXT_meshopt_compression + EXT_mesh_gpu_instancing; POSITION Float32; NORMAL normalized Int8 (8-bit); indices Uint16/Uint32" },
        "rootNodeName": { "const": "EXL50U_GA_VISUALIZATION" },
        "extensionsRequired": {
          "type": "array",
          "prefixItems": [
