# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.ppk
/.ssh/
/secrets/
/id_ed25519
/id_rsa
/fusiondigital_aliyun_hk
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
work-dev*.log
repro-*.log
gcm-diagnose.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/research/agent/artifacts/

# Reproducible runtime-model hydration and upload staging. The reviewed ITER
# derivative is restored from assets/runtime-assets.lock.json, not committed.
/public/models/iter-high-detail-v1/
# The EXL-50U general-assembly metadata and publication notice are tracked, but
# its reviewed preview and 20 high-detail GLBs are hydrated from the lock.
/public/models/exl50u-general-assembly-v1/*.glb
/.runtime-assets/
