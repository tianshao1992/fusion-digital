[Unit]
Description=FusionDigital mainland pre-ICP public-anonymous staging service
Documentation=file:/srv/fusiondigital/current/deploy/aliyun-mainland/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fusiondigital
Group=fusiondigital
WorkingDirectory=/srv/fusiondigital/current
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_FUSIONDIGITAL_MODE=public-anonymous
Environment=PORT=3000
Environment=VINEXT_TRUST_PROXY=1
Environment=VINEXT_TRUSTED_HOSTS=fusiondigital.club,www.fusiondigital.club
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/bin/node /srv/fusiondigital/current/deploy/aliyun-mainland/server.mjs
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
TasksMax=128
LimitNOFILE=65536
MemoryHigh=550M
MemoryMax=700M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target
