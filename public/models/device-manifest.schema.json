{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusiondigital.example/schemas/device-manifest-1.3.json",
  "title": "FusionDigital browser-safe device package manifest",
  "description": "Public metadata contract for a derived 3D asset. Authoritative CAD/CAE files remain in the controlled engineering data zone.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "asOf", "devicePackage", "access", "coordinateSystem", "assets", "systems", "generator", "disclaimer"],
  "properties": {
    "schemaVersion": { "enum": ["1.1", "1.2", "1.3"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "devicePackage": {
      "type": "object",
      "required": ["kind", "deviceClass", "authority", "replacementContract"],
      "properties": {
        "kind": { "enum": ["public-demonstrator", "public-simplified-derivative", "controlled-engineering"] },
        "deviceClass": { "type": "string" },
        "authority": { "enum": ["illustrative", "engineering-reference", "authoritative"] },
        "replacementContract": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["classification", "redistributionAllowed", "engineeringUseAllowed", "statement"],
      "properties": {
        "classification": { "enum": ["PUBLIC", "INTERNAL", "CONTROLLED", "RESTRICTED"] },
        "redistributionAllowed": { "type": "boolean" },
        "engineeringUseAllowed": { "type": "boolean" },
        "statement": { "type": "string" }
      },
      "additionalProperties": false
    },
    "coordinateSystem": {
      "type": "object",
      "required": ["linearUnit", "upAxis", "handedness", "sourceToWebScale"],
      "properties": {
        "linearUnit": { "type": "string" },
        "upAxis": { "enum": ["X", "Y", "Z"] },
        "handedness": { "enum": ["right", "left"] },
        "sourceToWebScale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "anyOf": [
        { "required": ["webModel"] },
        { "required": ["componentBundles"] }
      ],
      "properties": {
        "webModel": { "$ref": "#/$defs/asset" },
        "webModels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/webModelVariant" },
          "allOf": [
            {
              "contains": { "type": "object", "required": ["quality"], "properties": { "quality": { "const": "preview" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "required": ["default"], "properties": { "default": { "const": true } } },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "componentBundles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentBundle" }
        },
        "sourceCad": { "$ref": "#/$defs/asset" },
        "poster": { "$ref": "#/$defs/assetWithoutFormat" }
      },
      "additionalProperties": false
    },
    "visualizations": {
      "type": "object",
      "properties": {
        "analyticPlasma": { "$ref": "#/$defs/analyticPlasma" }
      },
      "additionalProperties": false
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "shortTitle", "category", "color", "description", "parts"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "shortTitle": { "type": "string" },
          "category": { "enum": ["plasma", "tf", "pf", "layer", "structure"] },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "description": { "type": "string" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "nodeName", "description", "engineeringTag"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "nodeName": { "type": "string" },
                "description": { "type": "string" },
                "engineeringTag": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "generator": { "type": "object" },
    "disclaimer": { "type": "string", "minLength": 30 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assets": { "required": ["componentBundles"] }
        },
        "required": ["assets"]
      },
      "then": { "properties": { "schemaVersion": { "enum": ["1.2", "1.3"] } } }
    },
    {
      "if": { "required": ["visualizations"] },
      "then": { "properties": { "schemaVersion": { "enum": ["1.2", "1.3"] } } }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.1", "1.2"] } },
        "required": ["schemaVersion"]
      },
      "then": { "properties": { "assets": { "required": ["webModel"] } } }
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["path", "format", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "format": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" }
      },
      "additionalProperties": false
    },
    "assetWithoutFormat": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "webModelVariant": {
      "type": "object",
      "required": ["id", "label", "quality", "path", "format", "sha256", "bytes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "quality": { "enum": ["preview", "high"] },
        "path": { "type": "string", "pattern": "^/" },
        "format": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" },
        "default": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "componentModel": {
      "type": "object",
      "required": ["partId", "nodeName", "path", "format", "sha256", "bytes", "triangles", "vertices", "sceneDrawTriangles", "sceneDrawVertices", "meshInstances", "decodedGpuBytes", "boundsMetres"],
      "properties": {
        "partId": { "type": "string", "minLength": 1 },
        "nodeName": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/device-assets/iter-high-detail/v1/[a-z0-9-]+\\.[a-f0-9]{64}\\.high\\.meshopt\\.glb$" },
        "format": { "const": "glTF 2.0 binary + EXT_meshopt_compression + KHR_mesh_quantization; POSITION normalized Int16 per mesh; NORMAL normalized Int8 (8-bit)" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "exclusiveMaximum": 25165824 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1 },
        "sceneDrawVertices": { "type": "integer", "minimum": 1 },
        "meshInstances": { "type": "integer", "minimum": 1, "maximum": 300 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" }
      },
      "additionalProperties": false
    },
    "componentBundle": {
      "type": "object",
      "required": ["id", "label", "quality", "delivery", "format", "bytes", "triangles", "vertices", "sceneDrawTriangles", "sceneDrawVertices", "meshInstances", "decodedGpuBytes", "boundsMetres", "components"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "quality": { "const": "high" },
        "delivery": { "const": "components" },
        "format": { "const": "glTF 2.0 binary + EXT_meshopt_compression + KHR_mesh_quantization; POSITION normalized Int16 per mesh; NORMAL normalized Int8 (8-bit)" },
        "bytes": { "type": "integer", "minimum": 80000000, "maximum": 110000000 },
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1 },
        "sceneDrawVertices": { "type": "integer", "minimum": 1 },
        "meshInstances": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentModel" }
        }
      },
      "additionalProperties": false
    },
    "analyticPlasma": {
      "type": "object",
      "required": [
        "kind", "label", "sourceLabel", "sourceUrl", "majorRadiusMetres", "minorRadiusMetres",
        "kappa95", "delta95", "kappaSeparatrixReference", "deltaSeparatrixReference",
        "nominalPlasmaCurrentMA", "toroidalFieldAtMajorRadiusT", "q95", "nominalVolumeCubicMetres",
        "topologyReference", "geometryOnly", "hasPsiGrid", "hasXPoint", "hasDiagnostics", "isEfit"
      ],
      "properties": {
        "kind": { "const": "analytic-design-proxy" },
        "label": { "type": "string", "minLength": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "majorRadiusMetres": { "type": "number", "exclusiveMinimum": 0 },
        "minorRadiusMetres": { "type": "number", "exclusiveMinimum": 0 },
        "kappa95": { "type": "number", "exclusiveMinimum": 0 },
        "delta95": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1 },
        "kappaSeparatrixReference": { "type": "number", "exclusiveMinimum": 0 },
        "deltaSeparatrixReference": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 1 },
        "nominalPlasmaCurrentMA": { "type": "number", "exclusiveMinimum": 0 },
        "toroidalFieldAtMajorRadiusT": { "type": "number", "exclusiveMinimum": 0 },
        "q95": { "type": "number", "exclusiveMinimum": 0 },
        "nominalVolumeCubicMetres": { "type": "number", "exclusiveMinimum": 0 },
        "topologyReference": { "const": "single-null" },
        "geometryOnly": { "const": true },
        "hasPsiGrid": { "const": false },
        "hasXPoint": { "const": false },
        "hasDiagnostics": { "const": false },
        "isEfit": { "const": false }
      },
      "additionalProperties": false
    },
    "boundsMetres": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
