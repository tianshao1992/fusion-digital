[Unit]
Description=Forward privacy-minimized FusionDigital analytics to the admin data plane
Documentation=file:/srv/fusiondigital/current/deploy/aliyun-hk/README.md
After=network-online.target fusiondigital-analytics-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=fusionanalytics
Group=fusionanalytics
EnvironmentFile=/etc/fusiondigital/analytics.env
ExecStartPre=/usr/bin/node /usr/local/lib/fusiondigital-analytics/current/analytics-forwarder.mjs --probe
ExecStart=/usr/bin/node /usr/local/lib/fusiondigital-analytics/current/analytics-forwarder.mjs
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/log/fusiondigital
ReadWritePaths=/var/lib/fusiondigital-analytics
StateDirectory=fusiondigital-analytics
StateDirectoryMode=0700
UMask=0077
MemoryMax=192M
TasksMax=32
