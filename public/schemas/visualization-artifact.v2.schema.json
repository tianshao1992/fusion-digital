{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusiondigital.club/schemas/visualization-artifact.v2.schema.json",
  "title": "FusionDigital Visualization Artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifactId", "version", "label", "sourceRecord", "provenance", "coordinates", "complexity", "access", "deliveries"],
  "properties": {
    "schema": { "const": "fusiondigital.visualization-artifact.v2" },
    "artifactId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "sourceRecord": { "$ref": "#/$defs/sourceRecord" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coordinates": { "$ref": "#/$defs/coordinates" },
    "complexity": { "$ref": "#/$defs/complexity" },
    "access": { "$ref": "#/$defs/access" },
    "deliveries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/delivery" } }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["facility-record", "simulation-run", "comparison-record", "design-asset"] },
        "id": { "type": "string", "minLength": 1 },
        "pulse": { "type": "string" },
        "run": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority"],
      "properties": {
        "authority": { "enum": ["raw", "calibrated", "reconstructed", "simulated", "synthetic"] },
        "generator": { "type": "string" },
        "generatedAt": { "type": "string" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "upAxis", "handedness"],
      "properties": {
        "units": { "type": "string", "minLength": 1 },
        "upAxis": { "enum": ["X", "Y", "Z"] },
        "handedness": { "enum": ["left", "right"] },
        "frame": { "type": "string" }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compressedBytes": { "type": "number", "minimum": 0 },
        "decodedBytes": { "type": "number", "minimum": 0 },
        "workingSetBytes": { "type": "number", "minimum": 0 },
        "triangles": { "type": "number", "minimum": 0 },
        "points": { "type": "number", "minimum": 0 },
        "cells": { "type": "number", "minimum": 0 },
        "timeSteps": { "type": "number", "minimum": 0 }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "clientDownloadAllowed"],
      "properties": {
        "classification": { "enum": ["public", "internal", "restricted"] },
        "clientDownloadAllowed": { "type": "boolean" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "format"],
      "properties": {
        "profile": { "enum": ["web-mesh", "web-tiles", "vtk-local", "paraview-remote", "openusd", "omniverse-stream"] },
        "format": { "type": "string", "minLength": 1 },
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "bytes": { "type": "number", "minimum": 0 },
        "lod": { "type": "number", "minimum": 0 }
      }
    }
  }
}
