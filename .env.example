# 可选：不配置任何供应商时，/search 和确定性知识检索仍可使用；/api/ask 自动回退到检索结果。
# 只把真实密钥写入本机 .env.local 或 Sites 加密环境变量，绝对不要提交到 Git。
LLM_DEFAULT_PROVIDER=openai

# 用户在账户中心保存个人 API Key 时使用的 32-byte base64url 主加密密钥。
# 线上必须作为 Sites Secret 设置；生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LLM_CREDENTIAL_KEK_V1=

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

MOONSHOT_API_KEY=
MOONSHOT_MODEL=
# 中国区使用 cn；国际区使用 international。仅允许这两个服务端固定端点。
MOONSHOT_REGION=cn

# 可选：Sites Worker 的 ITER 高清固定提交镜像。只接受下列 raw GitHub 精确形态：
# https://raw.githubusercontent.com/tianshao1992/fusion-physics-atlas-assets/<40位小写提交SHA>/iter-high-detail-v1
ITER_HIGH_DETAIL_ASSET_BASE_URL=

# 可选：Sites Worker 的 EXL-50U 总装固定提交镜像；规则同上，末段必须是精确 bundle id：
# https://raw.githubusercontent.com/tianshao1992/fusion-physics-atlas-assets/<40位小写提交SHA>/exl50u-general-assembly-v1
EXL50U_GENERAL_ASSEMBLY_ASSET_BASE_URL=

# 香港本机稳定匿名化密钥；至少 32 随机字节，仅写入香港 root-only 环境文件。
# SQLite 会锁定其指纹；更换前必须制定显式数据迁移或重置方案，不能直接轮换。
FUSIONDIGITAL_ANALYTICS_PSEUDONYM_SECRET=

# Sites 管理员报表桥的可轮换 HMAC 密钥；至少 32 随机字节，同一值分别写入 Sites Secret
# 与香港 root-only 环境文件。新统计事件不会写入 Sites D1。
FUSIONDIGITAL_ANALYTICS_REPORT_SECRET=

# 可选：`npm run start` 的监听端口。未设置时为 3000。
# PORT=3000
