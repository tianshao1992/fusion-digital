{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fusion-physics-atlas.example/schemas/efit-topology-graph-v2.schema.json",
  "title": "Browser-safe EFIT topology graph frame v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frameId",
    "shotId",
    "reconstructionId",
    "timeMs",
    "geometryId",
    "quality",
    "scalars",
    "closedFluxSurfaces",
    "topologyGraph"
  ],
  "properties": {
    "frameId": {"type": "string", "minLength": 1},
    "shotId": {"type": "string", "pattern": "^EXL-50U:shot:[0-9]{6}$"},
    "reconstructionId": {"type": "string", "pattern": "^exl-50u:efit:[0-9]{6}:[a-f0-9]{20}$"},
    "timeMs": {"type": "integer"},
    "geometryId": {"type": "string", "pattern": "^wall-[a-f0-9]{20}$"},
    "quality": {"$ref": "#/$defs/quality"},
    "scalars": {"$ref": "#/$defs/scalars"},
    "closedFluxSurfaces": {
      "type": "array",
      "maxItems": 73,
      "items": {"$ref": "#/$defs/closedSurface"}
    },
    "topologyGraph": {"$ref": "#/$defs/graph"}
  },
  "allOf": [
    {
      "if": {"properties": {"quality": {"properties": {"validity": {"const": "unavailable"}}}}},
      "then": {
        "properties": {
          "closedFluxSurfaces": {"maxItems": 0},
          "topologyGraph": {
            "properties": {
              "nodes": {"maxItems": 0},
              "edges": {"maxItems": 0},
              "wallArcs": {"maxItems": 0},
              "regions": {"maxItems": 0},
              "unresolvedArms": {"maxItems": 0},
              "unresolvedRegions": {"maxItems": 0}
            }
          }
        }
      },
      "else": {"properties": {"topologyGraph": {"properties": {"nodes": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "numberOrNull": {"type": ["number", "null"]},
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    },
    "points128": {
      "type": "array",
      "description": "Interleaved R,Z values for 128 unique equal-arc samples. Closure is the implicit final-to-first edge; the first coordinate is not repeated.",
      "minItems": 256,
      "maxItems": 256,
      "items": {"type": "number"}
    },
    "branchPoints": {
      "type": "array",
      "minItems": 128,
      "maxItems": 128,
      "items": {"type": "number"}
    },
    "wallArcPoints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 188,
      "items": {"type": "number"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "state", "confidence", "flags"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "flags": {"$ref": "#/$defs/flags"}
      }
    },
    "xEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "state", "reason", "confidence", "flags"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "flags": {"$ref": "#/$defs/flags"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validity", "flags", "positionUncertaintyFloorM", "sourceGrid", "algorithmVersion"],
      "properties": {
        "validity": {"enum": ["usable", "partial", "unavailable"]},
        "flags": {"$ref": "#/$defs/flags"},
        "positionUncertaintyFloorM": {"type": "number", "exclusiveMinimum": 0},
        "sourceGrid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nr", "nz", "rMinM", "rMaxM", "zMinM", "zMaxM"],
          "properties": {
            "nr": {"type": "integer", "minimum": 3, "maximum": 2049},
            "nz": {"type": "integer", "minimum": 3, "maximum": 2049},
            "rMinM": {"type": "number"},
            "rMaxM": {"type": "number"},
            "zMinM": {"type": "number"},
            "zMaxM": {"type": "number"}
          }
        },
        "algorithmVersion": {"type": "string", "minLength": 1}
      }
    },
    "scalars": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentA", "rAxisM", "zAxisM", "bcentrT", "psiAxisWbPerRad", "psiBoundaryWbPerRad", "q95", "efitError", "iconvr"],
      "properties": {
        "currentA": {"type": "number"},
        "rAxisM": {"type": "number"},
        "zAxisM": {"type": "number"},
        "bcentrT": {"type": "number"},
        "psiAxisWbPerRad": {"type": "number"},
        "psiBoundaryWbPerRad": {"type": "number"},
        "q95": {"$ref": "#/$defs/numberOrNull"},
        "efitError": {"$ref": "#/$defs/numberOrNull"},
        "iconvr": {"type": ["integer", "null"]}
      }
    },
    "closedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "source", "psiN", "closed", "containsMagneticAxis", "areaM2", "pointsRzM", "evidence"],
      "properties": {
        "surfaceId": {"type": "string", "minLength": 1},
        "source": {"enum": ["derived-contour", "g-eqdsk-boundary-polyline"]},
        "psiN": {"type": "number", "minimum": 0, "maximum": 1},
        "closed": {"const": true},
        "containsMagneticAxis": {"type": "boolean"},
        "areaM2": {"type": "number", "exclusiveMinimum": 0},
        "pointsRzM": {"$ref": "#/$defs/points128"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "magneticAxisNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "rM", "zM"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "kind": {"const": "magnetic-axis"},
        "rM": {"type": "number"},
        "zM": {"type": "number"}
      }
    },
    "xPointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "role", "activityRole", "activeBranchEligible", "evidenceOnly", "evidence", "rM", "zM", "psiN", "absPsiNMinusOne", "gradientResidual", "fitRms", "lcfsDistanceM", "hessianEigenvaluesPerM2", "positionUncertaintyM"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "kind": {"const": "x-point"},
        "role": {"enum": ["boundary", "near-boundary"]},
        "activityRole": {"enum": ["primary", "secondary"]},
        "activeBranchEligible": {"type": "boolean"},
        "evidenceOnly": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/xEvidence"},
        "rM": {"type": "number"},
        "zM": {"type": "number"},
        "psiN": {"type": "number"},
        "absPsiNMinusOne": {"type": "number", "minimum": 0, "maximum": 0.02},
        "gradientResidual": {"type": "number", "minimum": 0},
        "fitRms": {"type": "number", "minimum": 0, "maximum": 0.01},
        "lcfsDistanceM": {"type": "number", "minimum": 0},
        "hessianEigenvaluesPerM2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "positionUncertaintyM": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "wallNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "kind", "geometryId", "wallSegment", "wallSegmentFraction", "wallSNormalized", "rM", "zM", "positionUncertaintyM"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "kind": {"const": "wall-intersection"},
        "geometryId": {"type": "string", "minLength": 1},
        "wallSegment": {"type": "integer", "minimum": 0},
        "wallSegmentFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "wallSNormalized": {"type": "number", "minimum": 0, "maximum": 1},
        "rM": {"type": "number"},
        "zM": {"type": "number"},
        "positionUncertaintyM": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "kind", "status", "sourceArmIndex", "fromNodeId", "toNodeId", "psiN", "closed", "arcLengthM", "directDistanceM", "extensionRatio", "maxPsiNResidual", "pointsRzM"],
      "properties": {
        "edgeId": {"type": "string", "minLength": 1},
        "kind": {"const": "constant-flux-separatrix-branch"},
        "status": {"const": "active-derived"},
        "sourceArmIndex": {"type": "integer", "minimum": 0},
        "fromNodeId": {"type": "string", "minLength": 1},
        "toNodeId": {"type": "string", "minLength": 1},
        "psiN": {"type": "number"},
        "closed": {"type": "boolean"},
        "arcLengthM": {"type": "number", "minimum": 0},
        "directDistanceM": {"type": "number", "minimum": 0},
        "extensionRatio": {"$ref": "#/$defs/numberOrNull"},
        "maxPsiNResidual": {"type": "number", "minimum": 0, "maximum": 0.002000001},
        "pointsRzM": {"$ref": "#/$defs/branchPoints"}
      }
    },
    "wallArc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallArcId", "geometryId", "fromNodeId", "toNodeId", "direction", "wrapsCanonicalStart", "startSNormalized", "endSNormalized", "arcLengthM", "pointsRzM"],
      "properties": {
        "wallArcId": {"type": "string", "minLength": 1},
        "geometryId": {"type": "string", "minLength": 1},
        "fromNodeId": {"type": "string", "minLength": 1},
        "toNodeId": {"type": "string", "minLength": 1},
        "direction": {"const": "canonical-forward"},
        "wrapsCanonicalStart": {"type": "boolean"},
        "startSNormalized": {"type": "number", "minimum": 0, "maximum": 1},
        "endSNormalized": {"type": "number", "minimum": 0, "maximum": 1},
        "arcLengthM": {"type": "number", "minimum": 0},
        "pointsRzM": {"$ref": "#/$defs/wallArcPoints"}
      }
    },
    "regionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "referenceKind", "referenceId", "direction"],
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "referenceKind": {"enum": ["closed-surface", "branch-edge", "wall-arc"]},
        "referenceId": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "kind", "state", "psiN", "containsMagneticAxis", "areaM2", "boundary", "evidence"],
      "properties": {
        "regionId": {"type": "string", "minLength": 1},
        "kind": {"const": "closed-flux-region"},
        "state": {"const": "derived"},
        "psiN": {"type": "number", "minimum": 0, "maximum": 1},
        "containsMagneticAxis": {"type": "boolean"},
        "areaM2": {"type": "number", "exclusiveMinimum": 0},
        "boundary": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/regionBoundary"}},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "unresolvedArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolvedArmId", "xPointNodeId", "armIndex", "state", "reason", "extrapolated"],
      "properties": {
        "unresolvedArmId": {"type": "string", "minLength": 1},
        "xPointNodeId": {"type": "string", "minLength": 1},
        "armIndex": {"type": "integer", "minimum": 0},
        "state": {"const": "unresolved"},
        "reason": {"type": "string", "minLength": 1},
        "extrapolated": {"const": false}
      }
    },
    "unresolvedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolvedRegionId", "kind", "state", "reason", "edgeIds", "wallArcIds", "fabricated"],
      "properties": {
        "unresolvedRegionId": {"type": "string", "minLength": 1},
        "kind": {"const": "open-field-separatrix-region"},
        "state": {"const": "unresolved"},
        "reason": {"type": "string", "minLength": 1},
        "edgeIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "wallArcIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fabricated": {"const": false}
      }
    },
    "nullCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeIds", "distanceM", "deltaPsiN", "interpretation"],
      "properties": {
        "nodeIds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "distanceM": {"type": "number", "minimum": 0},
        "deltaPsiN": {"type": "number", "minimum": 0},
        "interpretation": {"const": "multi-null-cluster-candidate"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xPointCount", "activeXPointCount", "candidateXPointCount", "boundaryXPointCount", "nearBoundaryXPointCount", "wallIntersectionCount", "resolvedBranchCount", "unresolvedArmCount", "nullClusters", "extendedLegCandidateEdgeIds"],
      "properties": {
        "xPointCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "activeXPointCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "candidateXPointCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "boundaryXPointCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "nearBoundaryXPointCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "wallIntersectionCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "resolvedBranchCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "unresolvedArmCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "nullClusters": {"type": "array", "maxItems": 28, "items": {"$ref": "#/$defs/nullCluster"}},
        "extendedLegCandidateEdgeIds": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"type": "string", "minLength": 1}}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalRepresentation", "nodes", "edges", "wallArcs", "regions", "unresolvedArms", "unresolvedRegions", "features"],
      "properties": {
        "canonicalRepresentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "schemaVersion", "coordinateSpace", "geometryId"],
          "properties": {
            "kind": {"const": "node-edge-region-topology-graph"},
            "schemaVersion": {"const": "fusion.efit.topology-graph.v2"},
            "coordinateSpace": {"const": "EFIT cylindrical R-Z plane in metres"},
            "geometryId": {"type": "string", "minLength": 1}
          }
        },
        "nodes": {"type": "array", "maxItems": 41, "items": {"oneOf": [{"$ref": "#/$defs/magneticAxisNode"}, {"$ref": "#/$defs/xPointNode"}, {"$ref": "#/$defs/wallNode"}]}},
        "edges": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/edge"}},
        "wallArcs": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/wallArc"}},
        "regions": {"type": "array", "maxItems": 73, "items": {"$ref": "#/$defs/region"}},
        "unresolvedArms": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/unresolvedArm"}},
        "unresolvedRegions": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/unresolvedRegion"}},
        "features": {"$ref": "#/$defs/features"}
      }
    }
  }
}
