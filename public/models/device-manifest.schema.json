            "representsEngineeringSystems", "representsAssemblyTree"
          ],
          "properties": {
            "kind": { "const": "anonymous-transport" },
            "engineeringSemantic": { "const": false },
            "engineeringUseAllowed": { "const": false },
            "representsBom": { "const": false },
            "representsEngineeringSystems": { "const": false },
            "representsAssemblyTree": { "const": false }
          },
          "additionalProperties": false
        },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 314572800 },
        "uniqueGeometryMeshes": { "type": "integer", "minimum": 1 },
        "uniqueGeometryTriangles": { "type": "integer", "minimum": 1 },
        "uniqueGeometryVertices": { "type": "integer", "minimum": 1 },
        "placementInstances": { "type": "integer", "minimum": 1, "maximum": 5000000 },
        "drawCalls": { "type": "integer", "minimum": 1, "maximum": 800 },
        "sceneDrawTriangles": { "type": "integer", "minimum": 1, "maximum": 35000000 },
        "decodedGpuBytes": { "type": "integer", "minimum": 1, "maximum": 1610612736 },
        "boundsMetres": { "$ref": "#/$defs/boundsMetres" },
        "shards": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/anonymousShardModel" }
        }
      },
      "additionalProperties": false
    },
    "analyticPlasma": {
      "type": "object",
      "required": [
        "kind", "label", "sourceLabel", "sourceUrl", "majorRadiusMetres", "minorRadiusMetres",
        "kappa95", "delta95", "kappaSeparatrixReference", "deltaSeparatrixReference",
        "nominalPlasmaCurrentMA", "toroidalFieldAtMajorRadiusT", "q95", "nominalVolumeCubicMetres",
        "topologyReference", "geometryOnly", "hasPsiGrid", "hasXPoint", "hasDiagnostics", "isEfit"
      ],
      "properties": {
