{
  "name": "fusiondigital-community",
  "version": "1.0.0",
  "description": "FusionDigital fusion digital-twin research atlas and collaboration portal",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/rendered-html.test.mjs tests/device-publication-policy.test.mjs tests/efit-data.test.mjs tests/efit-delivery.test.mjs tests/efit-store.test.mjs tests/efit-ui.test.mjs tests/ui-preferences.test.mjs && tsx --test --test-concurrency=1 tests/efit-v2.test.mts tests/cad-theme.test.mts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern public --ignore-pattern research",
    "check": "npm run lint && npm test",
    "research:ai": "node scripts/research/ai-native.mjs rebuild",
    "research:audit": "node scripts/research/ai-native.mjs audit",
    "research:report": "node scripts/research/ai-native.mjs report",
    "research:control": "node scripts/research/control.mjs rebuild",
    "research:control:audit": "node scripts/research/control.mjs audit",
    "research:control:report": "node scripts/research/control.mjs report",
    "research:diagnostics": "node scripts/research/diagnostics.mjs rebuild",
    "research:diagnostics:audit": "node scripts/research/diagnostics.mjs audit",
    "research:diagnostics:report": "node scripts/research/diagnostics.mjs report",
    "research:graph": "node scripts/research/build-knowledge-graph.mjs",
    "search:build": "node scripts/search/build-index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "db:local:verify": "wrangler d1 execute DB --local --config wrangler.local.jsonc --command \"SELECT name FROM sqlite_schema WHERE type = 'table' AND name NOT LIKE '_cf_%' ORDER BY name; PRAGMA foreign_key_check;\" --persist-to .wrangler/state --json",
    "research:agent:dry-run": "node scripts/research/agent/discover.mjs --dry-run --scope all",
    "test:research-agent": "node --test tests/research-agent.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "echarts": "6.1.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
