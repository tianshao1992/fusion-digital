  "sourceRecord": {
    "kind": "design-asset",
    "id": "example-device-source"
  },
  "deliveries": [
    { "profile": "web-mesh", "format": "glb", "path": "web/example-device.glb" },
    { "profile": "openusd", "format": "usdc", "path": "usd/example-device.usdc" }
  ],
  "options": {
    "requireStableIds": false,
    "applyModifiers": true,
    "exportMaterials": true
