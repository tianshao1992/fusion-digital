  "outputRoot": "../../build/visualization/example-device",
  "authority": "synthetic",
  "classification": "internal",
  "clientDownloadAllowed": true,
  "coordinates": {
    "units": "m",
    "upAxis": "Z",
    "handedness": "right",
    "frame": "plant"
