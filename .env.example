# 可选：不配置任何供应商时，/search 和确定性知识检索仍可使用；/api/ask 自动回退到检索结果。
# 只把真实密钥写入本机 .env.local 或 Sites 加密环境变量，绝对不要提交到 Git。
LLM_DEFAULT_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

MOONSHOT_API_KEY=
MOONSHOT_MODEL=
# 中国区使用 cn；国际区使用 international。仅允许这两个服务端固定端点。
MOONSHOT_REGION=cn

# 可选：`npm run start` 的监听端口。未设置时为 3000。
# PORT=3000
